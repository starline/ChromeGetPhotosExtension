{
    "manifest_version": 3,
    "name": "GetPhotos",
    "description": "Извлекает ссылки на изображения с текущего сайта и показывает их в всплывающем окне.",
    "version": "0.1.0",
    "action": {
        "default_title": "GetPhotos"
    },
    "background": {
        "service_worker": "src/background.js"
    },
    "permissions": [
        "activeTab",
        "tabs",
        "scripting"
    ]
}
